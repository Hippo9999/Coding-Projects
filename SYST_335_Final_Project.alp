							<Value Class="CodeValue">
								<Code><![CDATA[Food_Supply += 2190;
Food_Empty_Event.restart();

Water_Supply += 3285;
Water_Empty_Event.restart();

Oxygen_Supply += 985.5;
Oxygen_Empty_Event.restart();

Rocket_Fuel = Rocket_Fuel + 2177000;

Hygiene_Clothing_OperationalSupplies += 2737.5;
HCO_Empty_Event.restart();

if (Stockout_Occurred == false) {
    Transport_Count++;
}

if (Offload_Cargo.count() >= 2) {
    Carbon_Dioxide_Level = Carbon_Dioxide_Level * 0.5;
}

// Check if this is exactly the second arrival
if (Offload_Cargo.count() == 2) {
    Days_Before_Second_Arrival = time(DAY);
}]]></Code>
