						<Condition><![CDATA[Hygiene_Clothing_OperationalSupplies <= 0]]></Condition>
					</Properties>
					<Action><![CDATA[HCO_Stockouts++;
Transports_Before_Failure = Transport_Count;
Stockout_Occurred = true;

// Check if this is the first failure
if (Days_Before_First_Failure == 0) {
    Days_Before_First_Failure = time(DAY);
}]]></Action>
				</Event>
