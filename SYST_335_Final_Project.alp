		<!--   =========  Parameter Variation Experiment   ========  -->
		<ParamVariationExperiment ActiveObjectClassId="1776793401061">
			<Id>1778458832676</Id>
			<Name><![CDATA[ParametersVariation]]></Name>
			<CommandLineArguments><![CDATA[]]></CommandLineArguments>
			<MaximumMemory>512</MaximumMemory>
			<RandomNumberGenerationType>customGenerator</RandomNumberGenerationType>
			<CustomGeneratorCode>new org.apache.commons.math3.random.RandomAdaptor(new org.apache.commons.math3.random.MersenneTwister())</CustomGeneratorCode>
			<AfterSimulationRunCode><![CDATA[//Caputre and Store means of each statistic
statsFirstFailure.add(root.Days_Before_First_Failure);
statsTransportCount.add(root.Transport_Count);
statsTransportsBeforeFail.add(root.Transports_Before_Failure);
statsSecondArrival.add(root.Days_Before_Second_Arrival);

// Capture and store final utilization from the resource pools
statRoverUtilization.add(root.Rovers.utilization());
statSparePartsUtilization.add(root.SpareParts.utilization());

// Check for division by zero if O2 stock can ever be 0
if (root.Oxygen_Supply > 0) {
    double ratio = root.Carbon_Dioxide_Level / root.Oxygen_Supply;
    statCO2toO2Ratio.add(ratio);
} else {
    statCO2toO2Ratio.add(0); // Or handle the edge case as preferred
}

// Capture final stock levels at the end of the run
statMeanWater.add(root.Water_Supply);
statMeanFood.add(root.Food_Supply);
statMeanOxygen.add(root.Oxygen_Supply);
statMeanCO2.add(root.Carbon_Dioxide_Level);
statMeanHygiene.add(root.Hygiene_Clothing_OperationalSupplies);]]></AfterSimulationRunCode>
			<SeedValue>1</SeedValue>
